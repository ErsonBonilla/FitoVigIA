# ============================================================================
# FITOVIGIA ENTERPRISE - CONFIGURACION DE ENTORNO
# Vigilancia Fitosanitaria Multinivel para el Cultivo de Arroz en el Tolima
# ============================================================================

# --- Entorno General ---
FITOVIGIA_ENV=production
FITOVIGIA_APP_NAME="FitoVigIA Enterprise API"
FITOVIGIA_VERSION="1.0.0"

# --- Seguridad & Autenticacion JWT ---
FITOVIGIA_SECRET_KEY="fitovigia-tolima-enterprise-secret-key-change-in-prod-2026"
FITOVIGIA_JWT_ALGORITHM="HS256"
FITOVIGIA_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Rutas de Datasets y Artefactos ---
FITOVIGIA_DATASET_ROOT="./dataset"
FITOVIGIA_MODELS_DIR="./models"
FITOVIGIA_ARTIFACTS_DIR="./artifacts"
FITOVIGIA_STORAGE_LOCAL_DIR="./storage_local"

# --- Motor de IA e Inferencia (CUDA / ONNX / PyTorch / YOLO) ---
# Modos soportados: onnx | pytorch | mlflow
FITOVIGIA_MODEL_SOURCE="onnx"
FITOVIGIA_USE_CUDA=true
FITOVIGIA_AMP_FP16=true
FITOVIGIA_BATCH_SIZE=16
FITOVIGIA_GRAD_ACCUM_STEPS=2
FITOVIGIA_SUBSET_PER_CLASS=300

# --- MLflow Tracking & Model Registry ---
FITOVIGIA_MLFLOW_URI="sqlite:///./mlflow.db"
FITOVIGIA_MLFLOW_EXPERIMENT="FitoVigIA_Tolima_Fitosanitario"
FITOVIGIA_MLFLOW_MODEL_NAME="fitovigia_rice_classifier"
FITOVIGIA_MLFLOW_STAGE="Staging"

# --- Base de Datos Geoespacial (PostgreSQL + PostGIS Principal / Respaldo SQLite) ---
FITOVIGIA_DATABASE_URL="postgresql+psycopg2://fitovigia:fitovigia_secret@localhost:5432/fitovigia_geo"
FITOVIGIA_SQLITE_FALLBACK_URL="sqlite:///./fitovigia_enterprise.db"

# --- Procesamiento Asincrono (Celery + Redis) ---
FITOVIGIA_REDIS_URL="redis://localhost:6379/0"
FITOVIGIA_CELERY_EAGER_FALLBACK=true

# --- Almacenamiento de Objetos (MinIO / S3) ---
FITOVIGIA_MINIO_ENDPOINT="localhost:9000"
FITOVIGIA_MINIO_ACCESS_KEY="fitovigia_admin"
FITOVIGIA_MINIO_SECRET_KEY="fitovigia_minio_secret"
FITOVIGIA_MINIO_BUCKET="fitovigia-tolima-orthomosaics"
FITOVIGIA_MINIO_SECURE=false
